(
/*
Direction: input GWDM 2.3 -> output GWDM 2.4 (the path is output-first).

GWDM 2.4 only adds optional fields (required.recordType, crocod). Everything
that reaches GWDM 2.3 is a dataset, so recordType is set to "dataset"
explicitly rather than left to the schema default.
*/
input ~> |$| {
  "required": required ~> |$| { "recordType": "dataset" }|
}|
)
