(
/*
=============================================================================
GWDM 2.4 → CROCOD 1.0.0 Translation
=============================================================================

Direction: input GWDM 2.4 -> output CROCOD 1.0.0 (the path is output-first).

The reverse of maps/GWDM/2.4/CROCOD/1.0.0. Only caseStudy records can be
translated; datasets are refused.

Fields are read back from where that map stores them in full - the crocod
section, plus the core fields it moves losslessly (title, shortTitle,
populationSize, temporal start/end years, coverage.spatial). The shortened
copies it writes for search (summary.abstract, description, funders,
contactPoint, linkage.datasetLinkage.linkedDatasets) are never read, because
crocod holds the originals.

summary.populationSize is only carried across when it is a positive count:
other maps use -1 for "unknown", and CROCOD requires at least 1.
*/

$year := function($date) {
  $date ? $number($substring($string($date), 0, 4)) : undefined
};

$split2 := function($x) {
  ($x and $type($x) = "string") ? $split($x, ";,;") : undefined
};

$nonEmpty := function($o) {
  ($o and $count($keys($o)) > 0) ? $o : undefined
};

$crocod := input.crocod;
$population := input.summary.populationSize;

input.required.recordType != "caseStudy"
  ? $error("Only GWDM 2.4 caseStudy records can be translated to CROCOD")
  : {
      "id": $match(input.required.gatewayId, /^[0-9]+$/) ? $number(input.required.gatewayId) : undefined,
      "pid": input.required.gatewayPid,
      "version": input.required.version,
      "issued": input.required.issued,
      "modified": input.required.modified,
      "trialSummary": {
        "acronym": input.summary.shortTitle,
        "fullTitle": input.summary.title,
        "status": $crocod.trialStatus,
        "therapeuticArea": $crocod.therapeuticArea,
        "laySummary": $crocod.laySummary,
        "background": $crocod.background
      },
      "trialDesign": $nonEmpty({
        "categories": $crocod.trialDesign.categories,
        "designDescription": $crocod.trialDesign.designDescription,
        "registration": $crocod.trialDesign.registration,
        "startYear": $year(input.provenance.temporal.startDate),
        "endYear": $year(input.provenance.temporal.endDate),
        "numberOfParticipants": ($population and $population > 0) ? $population : undefined
      }),
      "governance": $crocod.governance,
      "healthSystemsData": $nonEmpty($merge([
        $crocod.healthSystemsData ? $crocod.healthSystemsData : {},
        { "participantLocations": $split2(input.coverage.spatial) }
      ])),
      "learnings": $crocod.learnings,
      "publications": $crocod.publications,
      "readMore": $crocod.readMore
    }
)
