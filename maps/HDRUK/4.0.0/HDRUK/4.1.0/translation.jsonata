(
/*
Notes:
    - Direction: input HDRUK 4.1.0 -> output HDRUK 4.0.0 (path is output-first)
    - Drops the fields introduced in 4.1.0: accessibility.usage.duoCodes and
      accessibility.usage.dataUsePermissions have no 4.0.0 equivalent
    - conformsTo is narrowed: BNF, DDI and DCAT are members of StandardisedDataModelsEnumV2
      but not of the 4.0.0 enum, so they collapse to OTHER
    - $distinct stops a dataset carrying two or more of the new values emitting repeated OTHER
*/
$allowedStandards := [
    "HL7 FHIR",
    "HL7 V2",
    "HL7 CDA",
    "HL7 CCOW",
    "LOINC",
    "DICOM",
    "I2B2",
    "IHE",
    "OMOP",
    "OPENEHR",
    "SENTINEL",
    "PCORNET",
    "CDISC",
    "NHS DATA DICTIONARY",
    "NHS SCOTLAND DATA DICTIONARY",
    "NHS WALES DATA DICTIONARY",
    "LOCAL",
    "OTHER"
];

input ~> |$| {
  "accessibility": accessibility ~> |$| {
    "usage": usage ? usage ~> |$|{}, ["duoCodes", "dataUsePermissions"]| : null,
    "formatAndStandards": formatAndStandards ? formatAndStandards ~> |$| {
      "conformsTo": $distinct([$map(conformsTo, function($v) {
        $v in $allowedStandards ? $v : "OTHER"
      })])
    }| : null
  }|
}|
)
